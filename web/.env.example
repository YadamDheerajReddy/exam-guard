NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — bypasses RLS. Supabase Dashboard: Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — generate with `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
BARCODE_TOKEN_SECRET=

# Server-only — sends credential emails (org admin / student / invigilator
# temp passwords) via Gmail SMTP, free, no domain needed. Use a Gmail
# account with 2-Step Verification turned on, then create an App Password
# at https://myaccount.google.com/apppasswords (choose "Mail" as the app).
# GMAIL_USER is the full Gmail address; GMAIL_APP_PASSWORD is the 16-character
# app password (not your normal Gmail password). If unset, credential emails
# are skipped with a warning logged — account creation still works.
GMAIL_USER=
GMAIL_APP_PASSWORD=
