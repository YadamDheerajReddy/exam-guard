NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — bypasses RLS. Supabase Dashboard: Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — generate with `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
BARCODE_TOKEN_SECRET=

# Server-only — sends credential emails (org admin / student / invigilator
# temp passwords, password resets) via plain SMTP. Works with any provider.
# If unset, credential emails are skipped with a warning logged — account
# creation still works, the admin just can't hand off the temp password by
# email (it's still shown/available in the UI where applicable).
#
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#   SMTP_PASSWORD=<16-char App Password from
#   https://myaccount.google.com/apppasswords — requires 2-Step Verification>
#
# Hostinger business email: SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465,
#   SMTP_USER=you@yourdomain.com, SMTP_PASSWORD=<that mailbox's password,
#   set when you created it in hPanel — Emails -> Email Accounts>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Optional — the From: header shown to recipients. Defaults to
# "ExamGuard <SMTP_USER>" if unset.
MAIL_FROM=
